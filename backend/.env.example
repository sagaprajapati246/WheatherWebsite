# Backend Environment Variables (.env file for local development)

# MongoDB Connection String
# For local development:
MONGODB_URI=mongodb://localhost:27017/weather-dashboard

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/weather-dashboard?retryWrites=true&w=majority

# Server Port (optional, defaults to 5000)
PORT=5000

# Frontend API URL (used by Netlify to communicate with backend)
# This should be set in Netlify dashboard, not in this file
# VITE_API_URL=https://your-railway-url.app
